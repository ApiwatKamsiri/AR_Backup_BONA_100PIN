/// @brief  Generic interrupt subroutine function for a %DEVNAME%
static void %DEVNAME%Isr(const tsDevCom *device)
{
    ts%DEVNAMEPC%Params *params       = device->parameters;
    const ts%DEVNAMEPC%Consts *consts = device->constants;
    tsDevComSystem *sys               = device->sys;

    UNUSED(params); // REMOVE IF USED
    UNUSED(consts); // REMOVE IF USED

    if (sys->closed)
    {
        // Close function called before ISR
        sys->closed = NULL;
        TICKET_REMOVE(sys->tvm);
    }
    else
    {
        // ISR arrived but there's no close request yet
        sys->closed = sys->opened;
    }
}

