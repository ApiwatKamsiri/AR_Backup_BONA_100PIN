/// @brief  Open function for a %DEVNAME%
static DEV_COM_FUNC_OPEN(%DEVNAME%Open)
{
    ts%DEVNAMEPC%Params *params       = device->parameters;
    const ts%DEVNAMEPC%Consts *consts = device->constants;
    tsDevComSystem *sys               = device->sys;

    UNUSED(params); // REMOVE IF USED
    UNUSED(consts); // REMOVE IF USED

    if (!sys->initialized)
    {
        return EXIT_FAILURE;
    }

    if (target)
    {
        if (sys->opened || sys->closed)
        {
            // Previous session did not closed yet
            return EXIT_FAILURE;
        }
        else
        {
            sys->opened = target;
            sys->closed = NULL;
            return EXIT_SUCCESS;
        }
    }
    else
    {
        return EXIT_FAILURE;
    }
}

/// @brief  Close function for a %DEVNAME%
static DEV_COM_FUNC_CLOSE(%DEVNAME%Close)
{
    ts%DEVNAMEPC%Params *params       = device->parameters;
    const ts%DEVNAMEPC%Consts *consts = device->constants;
    tsDevComSystem *sys               = device->sys;

    UNUSED(params); // REMOVE IF USED
    UNUSED(consts); // REMOVE IF USED

    if (!sys->initialized)
    {
        return EXIT_FAILURE;
    }

    if (sys->opened == target)
    {
        globalIntDisable();
        if (sys->closed)
        {
            // Last operation is already finished in ISR
            sys->closed = NULL;
            TICKET_REMOVE(sys->tvm);
        }
        else
        {
            // Close after ISR
            sys->closed = sys->opened;
        }
        sys->opened = NULL;
        globalIntEnable();

        return EXIT_SUCCESS;
    }
    else
    {
        return EXIT_FAILURE;
    }
}

